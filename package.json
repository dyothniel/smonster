{
  "name": "smonster",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "playwright:install": "playwright install chromium",
    "smoketest": "npm run build && node dist/smoketest.js",
    "test": "npm run build && node --test dist",
    "start": "npm run build && node dist/server/index.js",
    "create-super-admin": "npm run build && node dist/server/scripts/createSuperAdmin.js",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-assets.js",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && electron dist-electron/electron/main/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "patchright": "^1.64.2",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/tar": "^6.1.13",
    "electron": "^45.2.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  }
}
